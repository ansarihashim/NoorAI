# Backend HTTP base. In production this is your Render service URL.
VITE_API_URL=http://localhost:8000

# Backend WebSocket URL for /ws/audio (narration + ask-a-doubt).
# Use `wss://` in production (Render is HTTPS-only on the public edge).
VITE_WS_URL=ws://localhost:8000/ws/audio

# When `true`, the frontend serves all AI answers, narrations, podcasts,
# visuals and revision sets from local cached fixtures under `src/demo/`
# and authenticates a single demo account (demo@noorai.ai / demo123).
# Set this on Vercel for the public/portfolio deployment so a recruiter
# can explore the whole product without burning Groq / TTS quota.
VITE_DEMO_MODE=false
