# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Env (never commit secrets)
.env
.env.*
*.env
!.env.example
*.local

# TLS / signing material
*.pem
*.key

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Project artifacts
*.faiss
*.index
*.pkl
storage/
backend/storage/
*.sqlite
*.sqlite3
*.db

# Cloud credentials — never commit any GCP / AWS / Azure service-account
# JSON. Filenames are autogenerated so we cast a wide net.
google-tts-sa.json
*service-account*.json
*-credentials*.json
gcp-*.json
backend/ecoverse-*.json
# Catch-all for anything name-shaped like "letters-numbers.json" sitting
# at the backend root (the form GCP keys arrive in by default).
backend/*-*-*.json

# Logs
*.log

# Claude / agent local state
.claude/

# Render local cache
.render/

# Vercel local cache
.vercel/

# Temp
*.tmp
*.bak
