# ---------- LLM (required) ----------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- TTS (all optional; falls back to free Edge-TTS) ----------
# When ELEVENLABS_API_KEY is blank or the daily char budget runs out, the
# service automatically falls through to free Microsoft Edge TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_GUEST_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---------- Database (required in prod) ----------
# Use Neon's free tier. MUST use the +asyncpg driver and ?ssl=require.
# Example: postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech/neondb?ssl=require
DATABASE_URL=

# ---------- Embeddings (HuggingFace Inference API — required) ----------
# Free token: https://huggingface.co/settings/tokens (read-access is enough).
# Replaces the local sentence-transformers load — saves ~500 MB RAM.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Vector DB (Pinecone serverless — required) ----------
# Free key: https://app.pinecone.io (Starter tier is enough).
# Index is auto-created on first use with dimension=384 and cosine metric.
# If you change HUGGINGFACE_EMBED_MODEL to one with a different dimension,
# delete the Pinecone index from the dashboard first so it recreates.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=noorai-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- Auth (required) ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ---------- App ----------
APP_ENV=prod
# Public URL of the deployed frontend (Vercel).
FRONTEND_URL=https://your-app.vercel.app
# CORS allowlist for HTTP + WebSocket origin check. Comma-separated.
CORS_ORIGINS=https://your-app.vercel.app
# Use /tmp on Render free (no persistent disk). The rag service mirrors
# uploads to Postgres so this directory being wiped is safe.
STORAGE_DIR=/tmp/storage
SESSION_MAX_MINUTES=30
ELEVENLABS_CHARS_PER_DAY=50000
