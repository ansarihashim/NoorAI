# ---------- LLM (required) ----------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- TTS (all optional; falls back to free Edge-TTS) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_GUEST_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Path to a GCP service-account JSON (NOT an API key) — leave blank to skip.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- Database (required in prod) ----------
# Use Neon's free tier. MUST use the +asyncpg driver and ?ssl=require.
# Example: postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech/neondb?ssl=require
DATABASE_URL=

# ---------- Whisper (sized for 512MB Render free tier) ----------
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------- Auth (required) ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ---------- App ----------
APP_ENV=prod
# Public URL of the deployed frontend (Vercel).
FRONTEND_URL=https://your-app.vercel.app
# CORS allowlist for HTTP + WebSocket origin check. Comma-separated.
CORS_ORIGINS=https://your-app.vercel.app
# Use /tmp on Render free (no persistent disk). The rag service mirrors
# uploads to Postgres so this directory being wiped is safe.
STORAGE_DIR=/tmp/storage
SESSION_MAX_MINUTES=30
ELEVENLABS_CHARS_PER_DAY=50000
